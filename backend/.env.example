# Taille du modèle : tiny | base | small | medium | large-v3
# "small" tourne sur le plan CPU de Railway ; "medium"+ demande plus de RAM
WHISPER_MODEL=small
COMPUTE_TYPE=int8
MAX_UPLOAD_MB=200
# En production, restreindre aux origines de l'application :
ALLOWED_ORIGINS=*

# Analyse qualitative (méthode Gioia) — facultatif.
# Sans cette clé, la transcription fonctionne normalement mais le bouton
# "Lancer l'analyse qualitative" renverra une erreur claire dans l'app.
# Clé obtenue sur https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-sonnet-5 = qualité maximale (plus lent).
# claude-haiku-4-5-20251001 = nettement plus rapide, qualité légèrement en retrait.
ANALYSE_MODEL=claude-sonnet-5

# Authentification — OBLIGATOIRE. Génère une chaîne aléatoire longue, par
# exemple avec `openssl rand -hex 32`, et ne la partage jamais.
JWT_SECRET=

# Base de données — OBLIGATOIRE pour une vraie persistance (comptes, corpus,
# transcriptions qui survivent aux redémarrages). Railway la fournit
# automatiquement si tu ajoutes un service PostgreSQL au projet et le relies
# via une "Reference Variable" (${{Postgres.DATABASE_URL}}). Sans elle, le
# serveur retombe sur un fichier SQLite local qui sera EFFACÉ à chaque
# redéploiement — à n'utiliser que pour tester.
DATABASE_URL=

# Diarisation des locuteurs — facultatif, et plus lourd à mettre en place.
# 1. Accepte les conditions du modèle sur https://huggingface.co/pyannote/speaker-diarization-3.1
# 2. Crée un jeton d'accès sur https://huggingface.co/settings/tokens
# 3. Colle-le ici. Sans lui, la transcription fonctionne normalement, seule
#    la distinction entre locuteurs est simplement absente.
HF_TOKEN=

# Vérification d'e-mail et mot de passe oublié — fortement recommandé.
# Compatible avec un compte Gmail (utiliser un "mot de passe d'application",
# pas ton mot de passe Gmail normal : https://myaccount.google.com/apppasswords)
# ou tout autre fournisseur SMTP (SendGrid, Resend, etc.).
# SANS ces variables, l'app reste utilisable : les comptes sont auto-vérifiés
# et reçoivent leur crédit d'essai immédiatement, mais sans vraie vérification
# d'adresse e-mail ni possibilité d'envoyer un code de réinitialisation.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Système de crédits et forfaits.
# Le compte dosso.choilio@gmail.com devient automatiquement administrateur
# (accès illimité, gestion des utilisateurs et des forfaits) — aucune
# variable à configurer pour ça, c'est déjà intégré au code.
CREDITS_ESSAI_GRATUIT=5
COUT_CREDIT_TRANSCRIPTION=1
COUT_CREDIT_ANALYSE=2
COUT_CREDIT_GUIDE=1
COUT_CREDIT_ETUDE_QUANT=3
COUT_CREDIT_ANALYSE_QUANT=2

# Recharge de crédits à la carte (paiement réel par les utilisateurs) via PayDunya.
# 150 FCFA par crédit, 10 crédits minimum — modifiable ci-dessous.
PRIX_CREDIT_FCFA=150
CREDITS_MIN_RECHARGE=10
PAYMENT_PROVIDER=paydunya
# Adresse publique de CE serveur Railway (nécessaire pour recevoir la confirmation
# de paiement de PayDunya) — sans le "/" final.
BACKEND_PUBLIC_URL=https://djeliya-production.up.railway.app
# Les TROIS identifiants ci-dessous sont requis (la clé maîtresse seule ne suffit
# jamais) — à récupérer sur https://app.paydunya.com dans les paramètres de ton
# "AppDunya". Utilise les clés de TEST tant que l'intégration n'est pas validée,
# les clés LIVE seulement une fois prêt à encaisser de l'argent réel.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
