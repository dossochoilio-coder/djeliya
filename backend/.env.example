# Taille du modèle : tiny | base | small | medium | large-v3
# "small" tourne sur le plan CPU de Railway ; "medium"+ demande plus de RAM
WHISPER_MODEL=small
COMPUTE_TYPE=int8
MAX_UPLOAD_MB=200
# En production, restreindre aux origines de l'application :
ALLOWED_ORIGINS=*

# Analyse qualitative (méthode Gioia) — facultatif.
# Sans cette clé, la transcription fonctionne normalement mais le bouton
# "Lancer l'analyse qualitative" renverra une erreur claire dans l'app.
# Clé obtenue sur https://console.anthropic.com
ANTHROPIC_API_KEY=
ANALYSE_MODEL=claude-sonnet-5

# Authentification — OBLIGATOIRE. Génère une chaîne aléatoire longue, par
# exemple avec `openssl rand -hex 32`, et ne la partage jamais.
JWT_SECRET=

# Base de données — OBLIGATOIRE pour une vraie persistance (comptes, corpus,
# transcriptions qui survivent aux redémarrages). Railway la fournit
# automatiquement si tu ajoutes un service PostgreSQL au projet et le relies
# via une "Reference Variable" (${{Postgres.DATABASE_URL}}). Sans elle, le
# serveur retombe sur un fichier SQLite local qui sera EFFACÉ à chaque
# redéploiement — à n'utiliser que pour tester.
DATABASE_URL=

# Diarisation des locuteurs — facultatif, et plus lourd à mettre en place.
# 1. Accepte les conditions du modèle sur https://huggingface.co/pyannote/speaker-diarization-3.1
# 2. Crée un jeton d'accès sur https://huggingface.co/settings/tokens
# 3. Colle-le ici. Sans lui, la transcription fonctionne normalement, seule
#    la distinction entre locuteurs est simplement absente.
HF_TOKEN=
